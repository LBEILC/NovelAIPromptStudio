{
  "name": "novelai-prompt-studio",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A local-first asset and prompt manager for NovelAI Diffusion V4/V4.5.",
  "productName": "NovelAI Prompt Studio",
  "author": "LBEILC",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "package": "npm run build && electron-builder --publish never",
    "verify:update-artifacts": "node scripts/verify-update-artifacts.mjs release",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "font-list": "2.1.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "sql.js": "1.14.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lobehub/ui": "5.20.3",
    "@lobehub/webfont-geist": "1.0.0",
    "@lobehub/webfont-geist-mono": "1.0.0",
    "@lobehub/webfont-harmony-sans-sc": "1.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "lucide-react": "1.24.0",
    "motion": "12.40.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.3",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "studio.novelai.prompt",
    "directories": {
      "output": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/**/*",
      "!electron/**/*.test.js",
      "!src/lib/**/*.test.js",
      "build/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LBEILC",
        "repo": "NovelAIPromptStudio",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NovelAI-Prompt-Studio-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "NovelAI-Prompt-Studio-${version}-${arch}.${ext}",
      "category": "public.app-category.graphics-design"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
