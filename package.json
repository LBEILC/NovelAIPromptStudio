{
  "name": "novelai-prompt-studio",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "description": "A local-first asset and prompt manager for NovelAI Diffusion V4/V4.5.",
  "license": "GPL-3.0-only",
  "productName": "NovelAI Prompt Studio",
  "author": "LBEILC",
  "main": "electron/main.js",
  "scripts": {
    "check:prompt-blocks": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-prompt-blocks.mjs",
    "benchmark:data-layer": "node scripts/benchmark-data-layer.mjs",
    "benchmark:library": "node scripts/benchmark-library.mjs",
    "preview": "node preview/start.mjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:demo": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev --profile=demo\"",
    "build": "vite build",
    "dso:update": "node scripts/update-dso-dictionary.mjs",
    "dso:verify": "node scripts/update-dso-dictionary.mjs --check",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "package": "npm run fonts:check && npm run build && electron-builder --publish never",
    "screenshots:app": "npm run build && node scripts/app-screenshots.mjs",
    "screenshots:readme": "npm run build && node scripts/readme-screenshots.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "verify:update-artifacts": "node scripts/verify-update-artifacts.mjs release",
    "start": "electron .",
    "start:demo": "electron . --profile=demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && node scripts/check-js-names.mjs",
    "format": "prettier --write \"{src,electron,scripts}/**/*.{js,jsx,ts,tsx,cjs,mjs}\" \"vite.config.js\"",
    "format:check": "prettier --check \"{src,electron,scripts}/**/*.{js,jsx,ts,tsx,cjs,mjs}\" \"vite.config.js\"",
    "fonts": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "verify:fonts:package": "node scripts/verify-font-package.mjs",
    "verify:app": "npm run build && node scripts/verify-app.mjs",
    "verify:app:system-reduced": "npm run verify:app -- --reduced-motion --motion=system",
    "verify:packaged": "npm run fonts:check && npm run build && node scripts/verify-app.mjs --packaged"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "font-list": "2.1.0",
    "koffi": "3.3.3",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remixicon": "4.9.1",
    "sharp": "0.35.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "happy-dom": "20.14.5",
    "lucide-react": "1.24.0",
    "motion": "12.40.0",
    "prettier": "3.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "studio.novelai.prompt",
    "directories": {
      "output": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/**/*",
      "src/shared/params.ts",
      "src/shared/inpaint.ts",
      "src/shared/nsfw.ts",
      "src/workbench/edits.ts",
      "src/workbench/model.ts",
      "agent/**/*",
      "!electron/**/*.test.js",
      "!electron/**/*.test.ts",
      "!electron/fixtures/**/*",
      "!electron/tools/*Screenshots.js",
      "!electron/tools/workbenchReference.js",
      "!src/lib/**/*.test.js",
      "!src/lib/**/*.test.ts",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent",
        "to": "agent"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES"
      },
      {
        "from": "third_party/DanbooruSearchOnline/README.md",
        "to": "LICENSES/DanbooruSearchOnline/README.md"
      },
      {
        "from": "third_party/DanbooruSearchOnline/LICENSE",
        "to": "LICENSES/DanbooruSearchOnline/LICENSE"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "LBEILC",
        "repo": "NovelAIPromptStudio",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "NovelAI-Prompt-Studio-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "NovelAI-Prompt-Studio-${version}-${arch}.${ext}",
      "category": "public.app-category.graphics-design"
    },
    "nsis": {
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "beforePack": "scripts/font-before-pack.mjs",
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ]
  }
}
